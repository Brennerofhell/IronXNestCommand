<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>IronXNestCommand</AssemblyName>
    <RootNamespace>IronXNestCommand</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Iron Nest Heavy Turret Simulator</GameFolder>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IronXNestCommand.Core\IronXNestCommand.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" IncludeAssets="compile" />
  </ItemGroup>

  <!-- Verweise auf die Spiel-Assemblies (IL2CPP Interop) -->
  <ItemGroup>
    <Reference Include="$(GameFolder)\MelonLoader\net6\0Harmony.dll" Condition="Exists('$(GameFolder)\MelonLoader\net6\0Harmony.dll')">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Condition="Exists('$(GameFolder)\MelonLoader\net6\Il2CppInterop.Runtime.dll')">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\MelonLoader\Il2CppAssemblies\*.dll" Condition="Exists('$(GameFolder)\MelonLoader\Il2CppAssemblies')">
      <Private>false</Private>
    </Reference>
    
    <!-- Fallback auf BepInEx Interop falls vorhanden -->
    <Reference Include="$(GameFolder)\BepInEx\interop\*.dll" Condition="Exists('$(GameFolder)\BepInEx\interop')">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(GameFolder)\BepInEx\core\Il2CppInterop.Runtime.dll" Condition="Exists('$(GameFolder)\BepInEx\core\Il2CppInterop.Runtime.dll')">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
