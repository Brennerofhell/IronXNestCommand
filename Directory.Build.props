<Project>
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Iron Nest Heavy Turret Simulator</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <BepInExCore>$(BepInExDir)\core</BepInExCore>
    <BepInExInterop>$(BepInExDir)\interop</BepInExInterop>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <Version>0.1.3</Version>
  </PropertyGroup>
</Project>
